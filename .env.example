# Application Settings
APP_NAME=engineering-knowledge-rag-assistant
HOST=127.0.0.1
PORT=8002
DEBUG=false

# Retrieval Configuration
DEFAULT_RETRIEVAL_MODE=hybrid
RRF_K=60
CHUNK_SIZE=450
CHUNK_OVERLAP=80

# Optional External Database (if connecting to remote Qdrant or PostgreSQL)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/rag_db
